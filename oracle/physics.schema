# Oracle trace schema for train physics: docs/re/physics.md §8 (addresses only).
global_tick       0x84c494 u32
phase_flags       0x855ff8 u32   # 0x200 driving, 0x400/0x10 coast
system_flags      0x855ffc u32
fpu_cw            0        fpucw # x87 control word (precision question)
power_notch       0x829d00 i32   # latched inputs
brake_notch       0x829d04 i32
stage             0x8570a4 i16
train_type        0x84c3fc i32
grade_scale       0x84c404 f32
curve_scale       0x84c42c f32
traction_scale    0x84c3f4 f32
brake_scale       0x84c438 f32
overrun_state     0x857206 i16   # >= 4 forced stop
power_cut         0x856fba i16
slippery          0x857230 i16
atc_limit_kmh     0x84c424 f32
brake_load        0x857084 i32
gradient          0x857228 f32
heading           0x850288 f32
speed             0x857234 f32   # m/s
t_fade            task+0x38 f32
t_speed           task+0x3c f32
t_accel           task+0x40 f32
t_force           task+0x44 f32
t_brake_cyl       task+0x4c f32
t_prev_heading    task+0x54 f32
t_brake_ticks     task+0x58 i32
t_last_power      task+0x60 i32
t_last_brake      task+0x64 i32
t_atc_latch       task+0x8c i16
gradient_force    0x84c3d8 f32
curve_sharpness   0x84c408 f32
odometer          0x857004 f32
leg_distance      0x84c40c f32
step_units        0x850208 f32
speed_two_back    0x84c41c f32
speed_lost        0x84c3f8 f32
speed_max         0x84c3f0 f32
brake_decel       0x84c420 f32
brake_decel_max   0x84c3e0 f32
brake_hist0       0x84c410 i32
brake_hist1       0x84c414 i32
brake_hist2       0x84c418 i32
brake_delta       0x84c3ec i32
remaining_counter 0x856fb0 i32
stage_clock       0x8570b0 i32
clock_speedup     0x856fac i16
clock_freeze      0x856d80 i16
units_to_stop     0x8500c8 f32
engine_index      0x8502a4 i32
dist_to_stop      0x85708c f32
dist_to_stop_r    0x85722c i32
station_index     0x856d78 i32
sched_next        0x8571e8 i32
seconds_late      0x856fc0 i32
